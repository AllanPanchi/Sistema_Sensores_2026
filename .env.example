# ============================================================================
#  HidroSentinel — Plantilla de variables de entorno
#  Copia este archivo a `.env` en la raíz del repositorio y completa los valores.
# ============================================================================

# --- SERVIDOR (Backend Node.js) ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Puerto del frontend (nginx) publicado al host en el despliegue con Docker
FRONTEND_PORT=8080

# --- POSTGRESQL — Inicialización del contenedor (leído por Docker Compose) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=cambia_esta_contraseña
POSTGRES_PORT=5434

# --- POSTGRESQL — Conexión del backend (leído por los pools de pg) ---
# PG_PORT debe coincidir con POSTGRES_PORT (el puerto publicado del contenedor).
PG_HOST=localhost
PG_PORT=5434
PG_USER=admin
PG_PASSWORD=cambia_esta_contraseña
PG_DB_USUARIOS=usuarios
PG_DB_SENSORES=sensores

# --- INFLUXDB — Inicialización del contenedor (leído por Docker Compose) ---
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=cambia_esta_contraseña
INFLUXDB_ORG=ESPE
INFLUXDB_BUCKET=boyas_telemetria
INFLUXDB_TOKEN=genera_un_token_seguro_aqui
INFLUXDB_PORT=8086

# --- INFLUXDB — Conexión del backend ---
# Si el backend corre dentro de Docker, usa http://influxdb:8086
INFLUXDB_URL=http://localhost:8086

# --- JWT (autenticación) ---
JWT_SECRET=define_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
