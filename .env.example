# --- SERVIDOR ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- POSTGRESQL (credenciales compartidas, dos bases de datos separadas) ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=tu_usuario
PG_PASSWORD=tu_contraseña
PG_DB_USUARIOS=usuarios
PG_DB_SENSORES=sensores

# --- INFLUXDB ---
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=tu_token_admin
INFLUXDB_ORG=tu_organizacion
INFLUXDB_BUCKET=tu_bucket

# Nota: INFLUXDB_URL debe ser accesible desde Node.js (fuera de Docker).
# Si corres el backend dentro de Docker, cambia localhost por el nombre
# del servicio: http://influxdb:8086
